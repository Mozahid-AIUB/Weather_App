# ================================================
# WeatherNow - NestJS Backend Environment Config
# Copy this file to .env and fill in your values
# ================================================

# Server
PORT=3001
NODE_ENV=production

# PostgreSQL (Your VPS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=weathernow
DB_USER=weathernow_user
DB_PASSWORD=your_strong_password_here
DB_SYNC=false
DB_LOGGING=false

# CORS
ALLOWED_ORIGINS=*
